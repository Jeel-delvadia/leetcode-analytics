{
  "manifest_version": 3,
  "name": "LeetCode Personal Analytics Collector",
  "version": "1.0.0",
  "description": "Collects LeetCode submissions, problem progress, and contest history for personal analytics.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["src/content/leetcode-page.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LeetCode Analytics"
  }
}
